class Solution {
public:
    int minMoves(vector<string>& nums, int energy) {
        int m=nums.size();
        int n=nums[0].size();
        vector<pair<int,int>>lit;
        int sr=0,sc=0;
        for(int i=0;i<m;i++){
            for(int j=0;j<n;++j){
                if(nums[i][j]=='S'){
                    sr=i;
                    sc=j;
                } 
                else if(nums[i][j]=='L'){
                    lit.push_back({i,j});
                }
            }
        }
        int k=lit.size();
        if(k==0)
            return 0;
        vector<vector<int>>vec(m,vector<int>(n,-1));
        for(int i=0;i<k;i++){
            auto [r,c]=lit[i];
            vec[r][c]=i;
        }
        int total=1<<k;
        int cells=m*n;
        vector<int>best(total*cells,-1);
        struct node{
            int r, c,mask,e;
        };
        queue<node>q;
        int start=sr*n+sc;
        best[start]=energy;
        q.push({sr,sc,0,energy});
        int moves=0;
        int dr[4]={-1,1,0,0};
        int dc[4]={0,0,-1,1};
        while(!q.empty()){
            int sz=q.size();
            while(sz--){
                auto [r,c,mask,e]=q.front();
                q.pop();
                if(mask==total-1)return moves;
                if(e==0)continue;
                for(int d=0;d<4;d++) {
                    int nr=r+dr[d];
                    int nc=c+dc[d];
                    if(nr<0||nr>=m||nc<0||nc>=n)continue;
                    if(nums[nr][nc]=='X')continue;
                    int ne=e-1;
                    int nmask=mask;
                    if(nums[nr][nc]=='R')ne=energy;
                    if(vec[nr][nc]!=-1)nmask|=(1<<vec[nr][nc]);
                    int pos=nr*n+nc;
                    int vecx=nmask*cells+pos;
                    if(best[vecx]>=ne)continue;
                    best[vecx]=ne;
                    q.push({nr,nc,nmask,ne});
                }
            }
            moves++;
        }
        return -1;
    }
};